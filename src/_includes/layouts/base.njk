{#-
  全ページ共通の骨組み。各ページの先頭（front matter）で次を指定する。
    title       … ページ名（<title> に「ページ名 | 牧場名」と出る。ホームは省略）
    description … 検索結果などに出る説明文（省略すると site.json の説明文）
    label / heading … ページ上部の緑の見出し（英字の小見出し / 大見出し）。省略すると出さない
-#}
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} | 仔牛を育てる牧場{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {%- if site.noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

{% include "components/header.njk" %}

  <main>
{% if heading %}
{% include "components/page-header.njk" %}
{% endif %}
{{ content | safe }}
  </main>

{% include "components/footer.njk" %}

  <script src="/js/main.js"></script>
</body>
</html>
